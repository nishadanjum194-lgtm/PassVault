{
  "name": "passvault",
  "version": "0.1.0",
  "description": "Local-only password manager for Anjum",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.anjum.passvault",
    "productName": "PassVault",
    "mac": { "target": "dir", "icon": "assets/pwd-icon-512.jpg", "category": "public.app-category.utilities" },
    "files": ["main.js","preload.js","renderer/**","assets/**"]
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}