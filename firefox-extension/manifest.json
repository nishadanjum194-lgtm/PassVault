{
  "manifest_version": 3,
  "name": "PassVault",
  "version": "0.2",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:47823/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "passvault@anjum",
      "strict_min_version": "109.0"
    }
  }
}